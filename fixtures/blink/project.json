    "files": [
      {
        "path": "sketch.ino",
        "content": "// Blink: LED externo no pino 13 (o mesmo do LED da placa).\nconst int LED = 13;\n\nvoid setup() {\n  pinMode(LED, OUTPUT);\n  Serial.begin(9600);\n  Serial.println(\"Blink iniciado\");\n}\n\nvoid loop() {\n  digitalWrite(LED, HIGH);\n  Serial.println(\"LED ligado\");\n  delay(500);\n  digitalWrite(LED, LOW);\n  Serial.println(\"LED desligado\");\n  delay(500);\n}"
      }
    ],
