  "firmware": {
    "fqbn": "arduino:avr:uno",
    "core": "arduino:avr@1.8.8",
    "mainFile": "sketch.ino",
    "files": [
      {
        "path": "sketch.ino",
        "content": "// DHT22 no pino 7; LCD 16x2 em modo 4 bits (RS=12, E=11, D4=5, D5=4, D6=3, D7=2).\n#include <LiquidCrystal.h>\n#include <DHT.h>\n\nLiquidCrystal lcd(12, 11, 5, 4, 3, 2);\nDHT dht(7, DHT22);\n\nvoid setup() {\n  Serial.begin(9600);\n  lcd.begin(16, 2);\n  lcd.print(\"Iniciando...\");\n  dht.begin();\n}\n\nvoid loop() {\n  delay(2000);\n  float h = dht.readHumidity();\n  float t = dht.readTemperature();\n  lcd.clear();\n  if (isnan(h) || isnan(t)) {\n    lcd.print(\"Falha no DHT22\");\n    Serial.println(\"Falha ao ler o DHT22\");\n    return;\n  }\n  lcd.setCursor(0, 0);\n  lcd.print(\"Temp: \");\n  lcd.print(t, 1);\n  lcd.print(\" C\");\n  lcd.setCursor(0, 1);\n  lcd.print(\"Umid: \");\n  lcd.print(h, 1);\n  lcd.print(\" %\");\n  Serial.print(\"T=\");\n  Serial.print(t, 1);\n  Serial.print(\" H=\");\n  Serial.println(h, 1);\n}"
      }
    ],
