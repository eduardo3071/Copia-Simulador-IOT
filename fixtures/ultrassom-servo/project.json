    "core": "arduino:avr@1.8.8",
    "mainFile": "sketch.ino",
    "files": [
      {
        "path": "sketch.ino",
        "content": "// HC-SR04 (TRIG=7, ECHO=8) aponta o servo (pino 9) e o buzzer (pino 10) apita abaixo de 20 cm.\n#include <Servo.h>\n\nconst int TRIG = 7;\nconst int ECHO = 8;\nconst int BUZZER = 10;\nServo servo;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(TRIG, OUTPUT);\n  pinMode(ECHO, INPUT);\n  servo.attach(9);\n}\n\nvoid loop() {\n  digitalWrite(TRIG, LOW);\n  delayMicroseconds(2);\n  digitalWrite(TRIG, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(TRIG, LOW);\n  unsigned long us = pulseIn(ECHO, HIGH, 30000UL);\n  float cm = us / 58.0;\n  int angle = constrain(map((long)cm, 2, 200, 0, 180), 0, 180);\n  servo.write(angle);\n  if (us > 0 && cm < 20) tone(BUZZER, 1000);\n  else noTone(BUZZER);\n  Serial.print(\"Distancia: \");\n  Serial.print(cm, 1);\n  Serial.print(\" cm  angulo: \");\n  Serial.println(angle);\n  delay(100);\n}"
      }
    ],
    "libraries": [
      {
        "name": "Servo",
        "version": "1.3.0"
      }
    ]
