    "mainFile": "sketch.ino",
    "files": [
      {
        "path": "sketch.ino",
        "content": "// Módulo LDR (AO em A0, DO em D2), potenciômetro deslizante em A1 e LED RGB em 9/10/11.\nconst int R = 9;\nconst int G = 10;\nconst int B = 11;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(2, INPUT);\n  pinMode(R, OUTPUT);\n  pinMode(G, OUTPUT);\n  pinMode(B, OUTPUT);\n}\n\nvoid loop() {\n  int luz = analogRead(A0);        // maior = mais escuro\n  int brilho = analogRead(A1) / 4; // 0-255\n  bool escuro = digitalRead(2) == HIGH;\n  if (escuro) {\n    analogWrite(R, 0);\n    analogWrite(G, 0);\n    analogWrite(B, brilho);\n  } else {\n    analogWrite(R, brilho);\n    analogWrite(G, brilho / 2);\n    analogWrite(B, 0);\n  }\n  Serial.print(\"AO=\");\n  Serial.print(luz);\n  Serial.print(\" DO=\");\n  Serial.print(escuro ? \"escuro\" : \"claro\");\n  Serial.print(\" brilho=\");\n  Serial.println(brilho);\n  delay(200);\n}"
      }
    ],
