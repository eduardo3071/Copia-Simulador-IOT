    "files": [
      {
        "path": "sketch.ino",
        "content": "// Botão no pino 2 (INPUT_PULLUP, ativo em LOW) controla o LED no pino 13.\nconst int BUTTON = 2;\nconst int LED = 13;\nbool lastPressed = false;\n\nvoid setup() {\n  pinMode(BUTTON, INPUT_PULLUP);\n  pinMode(LED, OUTPUT);\n  Serial.begin(9600);\n  Serial.println(\"Pronto\");\n}\n\nvoid loop() {\n  bool pressed = digitalRead(BUTTON) == LOW;\n  digitalWrite(LED, pressed ? HIGH : LOW);\n  if (pressed != lastPressed) {\n    Serial.println(pressed ? \"pressionado\" : \"solto\");\n    lastPressed = pressed;\n  }\n  delay(10);\n}"
      }
    ],
