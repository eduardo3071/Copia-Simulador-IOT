{
  "name": "simulador-iot",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma integrada de eletrônica, embarcados e IoT",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @simiot/api\" \"npm run dev -w @simiot/web\"",
    "build": "npm run build -w @simiot/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "setup:arduino": "node scripts/setup-arduino-cli.mjs",
    "build:fixtures": "tsx scripts/build-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@tscircuit/cableprinter": "0.0.6",
    "@tscircuit/capacity-autorouter": "0.0.988",
    "@tscircuit/checks": "0.0.257",
    "@tscircuit/circuit-json-util": "0.0.123",
    "@tscircuit/core": "0.0.2178",
    "@tscircuit/create-fdm-enclosure": "0.0.4",
    "@tscircuit/footprinter": "0.0.442",
    "@tscircuit/infgrid-ijump-astar": "0.0.35",
    "@tscircuit/matchpack": "0.0.97",
    "@tscircuit/math-utils": "0.0.36",
    "@tscircuit/modelprinter": "0.0.18",
    "@tscircuit/props": "0.0.704",
    "@tscircuit/schematic-match-adapt": "0.0.18",
    "bpc-graph": "0.0.57",
    "calculate-packing": "0.0.90",
    "circuit-json": "0.0.528",
    "circuit-json-to-bom-csv": "0.0.21",
    "circuit-json-to-bpc": "0.0.13",
    "circuit-json-to-connectivity-map": "0.0.33",
    "circuit-json-to-gerber": "0.0.113",
    "circuit-json-to-pnp-csv": "0.0.20",
    "circuit-json-to-spice": "0.0.45",
    "circuit-to-svg": "0.0.450",
    "react": "19.1.0",
    "schematic-symbols": "0.0.248",
    "spicets": "0.0.4"
  }
}
